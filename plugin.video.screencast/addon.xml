<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.screencast" name="Screencast" version="0.2.0" provider-name="tesla">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
    <import addon="inputstream.ffmpegdirect" version="20.0.0"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.service" library="service.py"/>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Shows a screen mirrored from a computer</summary>
    <summary lang="de_DE">Zeigt den gespiegelten Bildschirm eines Rechners</summary>
    <description lang="en_GB">Receiver for kodi-screencast. Started by the sender, not from the menu.</description>
    <description lang="de_DE">Empfänger für kodi-screencast. Wird vom Sender gestartet, nicht aus dem Menü.</description>
    <platform>all</platform>
    <license>MIT</license>
  </extension>
</addon>
